---
const target = new URL('/posts/', Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target.pathname}`} />
    <link rel="canonical" href={target} />
    <title>正在前往文章列表…</title>
  </head>
  <body><p>文章列表已迁移至 <a href={target.pathname}>/posts/</a>。</p></body>
</html>
