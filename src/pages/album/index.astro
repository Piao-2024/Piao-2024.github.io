---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import CompactIdentityHeader from "@/components/CompactIdentityHeader.astro";
import AlbumStatCard from "@/components/gallery/AlbumStatCard.astro";
import { PROVINCES } from "@/data/provinces";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const albums = await getCollection("albums");
const provinceMap = new Map<
  number,
  { slug: string; albumCount: number; photoCount: number }
>();

for (const album of albums) {
  const province = provinceMap.get(album.data.province.adcode) ?? {
    slug: album.data.province.slug,
    albumCount: 0,
    photoCount: 0,
  };
  province.albumCount += 1;
  province.photoCount += album.data.photos.length;
  provinceMap.set(album.data.province.adcode, province);
}

const visitedProvinces = PROVINCES.flatMap(province => {
  const stats = provinceMap.get(province.adcode);
  return stats ? [{ ...province, stats }] : [];
});
const unlockedCount = visitedProvinces.length;
const photoCount = albums.reduce(
  (sum, album) => sum + album.data.photos.length,
  0
);
---

<Layout
  title={`${t.pages.albumsTitle} | ${config.site.title}`}
  description={t.pages.albumsDesc}
  bodyClass="expanded-identity-body"
>
  <div class="expanded-page">
    <div class="expanded-ambient expanded-ambient-circle" aria-hidden="true">
    </div>
    <div class="expanded-ambient expanded-ambient-line" aria-hidden="true">
    </div>
    <div class="expanded-shell album-shell">
      <CompactIdentityHeader active="albums" />
      <div class="expanded-notice">▦ 一格一地，收藏走过的风景。</div>
      <main
        id="main-content"
        class="expanded-panel album-directory-panel"
        data-pagefind-body
      >
        <div class="expanded-heading">
          <div>
            <p class="eyebrow">PHOTO JOURNEY</p><h1>{t.pages.albumsTitle}</h1>
          </div>
          <span>{albums.length} 个系列 · {photoCount} 张照片</span>
        </div>

        <section class="album-stats" aria-label="旅行相册统计">
          <AlbumStatCard
            eyebrow="DESTINATIONS"
            label="到过的省份"
            value={unlockedCount}
            suffix={`/ ${PROVINCES.length}`}
            progress={unlockedCount / PROVINCES.length}
          />
          <AlbumStatCard
            eyebrow="PHOTOGRAPHS"
            label="已上传照片"
            value={photoCount}
            suffix="张"
          />
        </section>

        <section class="province-directory" aria-labelledby="province-title">
          <div class="directory-heading">
            <div>
              <p>DESTINATIONS</p>
              <h2 id="province-title">省份目录</h2>
            </div>
            <span>目前收录 {unlockedCount} 个省份</span>
          </div>
          <div class="province-grid">
            {
              visitedProvinces.map((province, index) => (
                <a
                  class="province-card"
                  href={getRelativeLocaleUrl(
                    locale,
                    `album/${province.stats.slug}`
                  )}
                  aria-label={`${province.name}，${province.stats.albumCount} 个摄影系列`}
                >
                  <span class="province-index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3>{province.name}</h3>
                    <p>
                      {province.stats.albumCount} 个系列 ·{" "}
                      {province.stats.photoCount} 张照片
                    </p>
                  </div>
                  <span class="province-state">查看相册 ↗</span>
                </a>
              ))
            }
          </div>
        </section>
      </main>
      <footer class="expanded-site-footer">
        <span>@ {new Date().getFullYear()}</span><strong>PIAO'S SPACE</strong>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .album-shell {
    width: min(74rem, calc(100% - 2rem));
  }
  .album-directory-panel {
    padding-bottom: 1.5rem;
  }
  .album-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin-top: 1.15rem;
  }
  .province-directory {
    margin-top: 1.5rem;
  }
  .directory-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }
  .directory-heading p {
    color: var(--expanded-accent);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.16em;
  }
  .directory-heading h2 {
    margin-top: 0.18rem;
    font-size: 1.15rem;
  }
  .directory-heading > span {
    color: color-mix(in srgb, var(--expanded-text) 52%, transparent);
    font-size: 0.65rem;
  }
  .province-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }
  .province-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    min-height: 6.25rem;
    padding: 0.9rem;
    border: 1px solid
      color-mix(in srgb, var(--expanded-accent) 13%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--expanded-surface) 72%, transparent);
    color: inherit;
    text-decoration: none;
  }
  .province-card {
    border-color: color-mix(in srgb, var(--expanded-accent) 34%, transparent);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--expanded-accent) 13%, transparent),
        transparent 60%
      ),
      color-mix(in srgb, var(--expanded-surface) 86%, transparent);
    box-shadow: 0 16px 38px -30px
      color-mix(in srgb, var(--expanded-accent) 65%, transparent);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .province-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--expanded-accent) 55%, transparent);
    box-shadow: 0 22px 42px -27px
      color-mix(in srgb, var(--expanded-accent) 72%, transparent);
  }
  .province-index {
    color: var(--expanded-accent);
    font-family: var(--font-google-sans-code);
    font-size: 0.62rem;
    font-weight: 700;
    opacity: 0.54;
  }
  .province-card h3 {
    padding-right: 3.2rem;
    font-size: 0.85rem;
    line-height: 1.35;
  }
  .province-card p {
    margin-top: 0.35rem;
    color: color-mix(in srgb, var(--expanded-text) 48%, transparent);
    font-size: 0.63rem;
  }
  .province-state {
    position: absolute;
    right: 0.8rem;
    bottom: 0.7rem;
    color: color-mix(in srgb, var(--expanded-text) 42%, transparent);
    font-size: 0.58rem;
  }
  .province-state {
    color: var(--expanded-accent);
    font-weight: 700;
  }
  @media (max-width: 58rem) {
    .province-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .album-shell {
      width: min(100% - 1rem, 74rem);
    }
    .album-directory-panel {
      padding: 1rem;
    }
    .album-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .directory-heading > span {
      display: none;
    }
    .province-grid {
      grid-template-columns: 1fr;
    }
    .province-card {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      min-height: 6.8rem;
    }
    .province-card h3 {
      padding-right: 0;
      font-size: 0.78rem;
    }
  }
  @media (max-width: 30rem) {
    .album-stats {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .province-card {
      transition: none;
    }
  }
</style>
