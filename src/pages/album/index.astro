---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import CompactIdentityHeader from "@/components/CompactIdentityHeader.astro";
import { PROVINCES } from "@/data/provinces";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const albums = await getCollection("albums");
const provinceMap = new Map<
  number,
  { slug: string; cover: string; albumCount: number; photoCount: number }
>();

for (const album of albums) {
  const province = provinceMap.get(album.data.province.adcode) ?? {
    slug: album.data.province.slug,
    cover: album.data.cover,
    albumCount: 0,
    photoCount: 0,
  };
  province.albumCount += 1;
  province.photoCount += album.data.photos.length;
  provinceMap.set(album.data.province.adcode, province);
}

const visitedProvinces = PROVINCES.flatMap(province => {
  const stats = provinceMap.get(province.adcode);
  return stats ? [{ ...province, stats }] : [];
});
const unlockedCount = visitedProvinces.length;
const photoCount = albums.reduce(
  (sum, album) => sum + album.data.photos.length,
  0
);
---

<Layout
  title={`${t.pages.albumsTitle} | ${config.site.title}`}
  description={t.pages.albumsDesc}
  bodyClass="expanded-identity-body"
>
  <div class="expanded-page">
    <div class="expanded-ambient expanded-ambient-circle" aria-hidden="true">
    </div>
    <div class="expanded-ambient expanded-ambient-line" aria-hidden="true">
    </div>
    <div class="expanded-shell album-shell">
      <CompactIdentityHeader active="albums" />
      <div class="expanded-notice">▦ 一格一地，收藏走过的风景。</div>
      <main
        id="main-content"
        class="expanded-panel album-directory-panel"
        data-pagefind-body
      >
        <div class="expanded-heading">
          <div>
            <p class="eyebrow">PHOTO JOURNEY</p><h1>{t.pages.albumsTitle}</h1>
          </div>
        </div>

        <section class="journey-summary" aria-label="旅行相册统计">
          <p class="journey-statement">
            已经走过 <strong>{unlockedCount}</strong> 个省份，留下
            <strong>{photoCount.toLocaleString(locale)}</strong> 张照片。
          </p>
          <div class="journey-progress">
            <p>
              China explored <span aria-hidden="true">·</span>
              {unlockedCount} / {PROVINCES.length}
              <span aria-hidden="true">·</span>
              {((unlockedCount / PROVINCES.length) * 100).toFixed(1)}%
            </p>
            <div class="journey-progress-track" aria-hidden="true">
              <span
                style={`width: ${Math.max((unlockedCount / PROVINCES.length) * 100, 1.5)}%`}
              ></span>
            </div>
          </div>
        </section>

        <section class="province-directory" aria-labelledby="province-title">
          <div class="directory-heading">
            <div>
              <p>DESTINATIONS</p>
              <h2 id="province-title">省份目录</h2>
            </div>
            <span>目前收录 {unlockedCount} 个省份</span>
          </div>
          <div class="province-grid">
            {
              visitedProvinces.map((province, index) => (
                <a
                  class="province-card"
                  href={getRelativeLocaleUrl(
                    locale,
                    `album/${province.stats.slug}`
                  )}
                  aria-label={`${province.name}，${province.stats.albumCount} 个摄影系列`}
                >
                  <div class="province-cover">
                    <img
                      src={province.stats.cover}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="province-copy">
                    <span class="province-index">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3>{province.name}</h3>
                    <p>
                      {province.stats.albumCount} 个系列 ·{" "}
                      {province.stats.photoCount} 张照片
                    </p>
                  </div>
                  <span class="province-state">查看相册 ↗</span>
                </a>
              ))
            }
          </div>
        </section>
      </main>
      <footer class="expanded-site-footer">
        <span>@ {new Date().getFullYear()}</span><strong>PIAO'S SPACE</strong>
      </footer>
    </div>
  </div>
</Layout>

<style>
  .album-shell {
    width: min(74rem, calc(100% - 2rem));
  }
  .album-directory-panel {
    padding-bottom: 1.5rem;
  }
  .journey-summary {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 1.1rem;
    padding: 0.35rem 0.25rem 1.15rem;
    border-bottom: 1px solid
      color-mix(in srgb, var(--expanded-accent) 16%, transparent);
  }
  .journey-statement {
    color: color-mix(in srgb, var(--expanded-text) 78%, transparent);
    font-size: clamp(1rem, 2vw, 1.3rem);
    line-height: 1.6;
  }
  .journey-statement strong {
    color: var(--expanded-accent);
    font-size: 1.18em;
    font-weight: 750;
  }
  .journey-progress {
    width: min(18rem, 38%);
    flex: none;
  }
  .journey-progress p {
    display: flex;
    justify-content: flex-end;
    gap: 0.45rem;
    color: color-mix(in srgb, var(--expanded-text) 48%, transparent);
    font-family: var(--font-google-sans-code);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .journey-progress p span {
    color: var(--expanded-accent);
    opacity: 0.52;
  }
  .journey-progress-track {
    height: 0.22rem;
    margin-top: 0.55rem;
    overflow: hidden;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--expanded-accent) 11%, transparent);
  }
  .journey-progress-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--expanded-accent);
  }
  .province-directory {
    margin-top: 1.15rem;
  }
  .directory-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
  }
  .directory-heading p {
    color: var(--expanded-accent);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.16em;
  }
  .directory-heading h2 {
    margin-top: 0.18rem;
    font-size: 1.15rem;
  }
  .directory-heading > span {
    color: color-mix(in srgb, var(--expanded-text) 52%, transparent);
    font-size: 0.65rem;
  }
  .province-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
  }
  .province-card {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.8rem;
    min-height: 6.25rem;
    padding: 0.65rem;
    border: 1px solid
      color-mix(in srgb, var(--expanded-accent) 13%, transparent);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--expanded-surface) 72%, transparent);
    color: inherit;
    text-decoration: none;
  }
  .province-card {
    border-color: color-mix(in srgb, var(--expanded-accent) 34%, transparent);
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--expanded-accent) 13%, transparent),
        transparent 60%
      ),
      color-mix(in srgb, var(--expanded-surface) 86%, transparent);
    box-shadow: 0 16px 38px -30px
      color-mix(in srgb, var(--expanded-accent) 65%, transparent);
    transition:
      transform 0.22s ease,
      box-shadow 0.22s ease,
      border-color 0.22s ease;
  }
  .province-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--expanded-accent) 55%, transparent);
    box-shadow: 0 22px 42px -27px
      color-mix(in srgb, var(--expanded-accent) 72%, transparent);
  }
  .province-index {
    display: block;
    color: var(--expanded-accent);
    font-family: var(--font-google-sans-code);
    font-size: 0.62rem;
    font-weight: 700;
    opacity: 0.54;
  }
  .province-cover {
    height: 4.9rem;
    overflow: hidden;
    border-radius: 0.72rem;
    background: var(--expanded-soft);
  }
  .province-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .province-card:hover .province-cover img {
    transform: scale(1.06);
  }
  .province-copy {
    min-width: 0;
    align-self: stretch;
    padding: 0.3rem 0 1rem;
  }
  .province-card h3 {
    padding-right: 3.2rem;
    font-size: 0.85rem;
    line-height: 1.35;
  }
  .province-card p {
    margin-top: 0.35rem;
    color: color-mix(in srgb, var(--expanded-text) 48%, transparent);
    font-size: 0.63rem;
  }
  .province-state {
    position: absolute;
    right: 0.8rem;
    bottom: 0.7rem;
    color: color-mix(in srgb, var(--expanded-text) 42%, transparent);
    font-size: 0.58rem;
  }
  .province-state {
    color: var(--expanded-accent);
    font-weight: 700;
  }
  @media (max-width: 58rem) {
    .province-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .album-shell {
      width: min(100% - 1rem, 74rem);
    }
    .album-directory-panel {
      padding: 1rem;
    }
    .journey-summary {
      display: block;
      padding-bottom: 1rem;
    }
    .journey-progress {
      width: 100%;
      margin-top: 0.75rem;
    }
    .journey-progress p {
      justify-content: flex-start;
    }
    .directory-heading > span {
      display: none;
    }
    .province-grid {
      grid-template-columns: 1fr;
    }
    .province-card {
      grid-template-columns: 4.75rem minmax(0, 1fr);
      gap: 0.75rem;
      min-height: 6.1rem;
    }
    .province-card h3 {
      padding-right: 3rem;
      font-size: 0.78rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .province-card {
      transition: none;
    }
  }
</style>
