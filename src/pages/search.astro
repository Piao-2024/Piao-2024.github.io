---
// Search now lives on the posts list. Keep this URL working (including
// ?q= links) by forwarding to /posts/ with the same query string.
import { getAssetPath } from "@/utils/withBase";

const target = getAssetPath("posts/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>正在前往文章搜索…</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body>
    <p>搜索已移到 <a href={target}>文章页</a>。</p>
  </body>
</html>
