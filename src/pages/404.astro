---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import ExpandedShell from "@/components/ExpandedShell.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <ExpandedShell>
    <main id="main-content" class="expanded-panel not-found">
      <p class="code">404</p>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <h1>{t.notFound.message}</h1>
      <a href={getRelativeLocaleUrl(locale, "")}>{t.notFound.goHome}</a>
    </main>
  </ExpandedShell>
</Layout>

<style>
  .not-found {
    display: flex;
    min-height: 24rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
  }
  .code {
    color: var(--accent);
    font-size: clamp(5rem, 18vw, 8rem);
    font-weight: 750;
    line-height: 1;
  }
  h1 {
    margin-top: 0.75rem;
    font-size: 1.5rem;
    font-weight: 650;
  }
  a {
    margin-top: 1.25rem;
    padding: 0.6rem 1.2rem;
    border-radius: 9999px;
    background: var(--muted);
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    transform: translateY(-2px);
  }
</style>
