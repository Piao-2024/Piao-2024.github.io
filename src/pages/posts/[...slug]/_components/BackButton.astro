---
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

{
  config.features.showBackButton && (
    <LinkButton
      id="back-button"
      href={getRelativeLocaleUrl(locale, "posts/")}
      class="focus-outline text-accent hover:text-foreground -ms-1 mb-4 text-sm"
    >
      <IconChevronLeft class="inline-block size-5 rtl:rotate-180" />
      <span>{t.post.goBack}</span>
    </LinkButton>
  )
}
