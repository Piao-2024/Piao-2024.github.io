<leetcode-card class="leetcode-card">
  <div class="heading">
    <h2>LeetCode Hot100</h2>
    <span data-count aria-live="polite">加载中…</span>
  </div>
  <progress aria-label="Hot100 完成进度" max="100" hidden></progress>
  <div class="details">
    <span data-status aria-live="polite">正在获取进度</span>
    <button type="button" hidden>重试</button>
    <a
      href="https://leetcode.cn/u/piao-16m/"
      target="_blank"
      rel="noopener noreferrer">个人主页 ↗</a
    >
  </div>
  <noscript>启用 JavaScript 即可查看最新进度。</noscript>
</leetcode-card>

<style>
  .leetcode-card {
    display: block;
    width: 100%;
    margin-top: 2rem;
    padding: 1rem;
    border-radius: 1rem;
    background: var(--accent-soft);
    font-size: 0.75rem;
  }
  .heading,
  .details {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .heading {
    justify-content: space-between;
  }
  h2 {
    font-size: 0.8rem;
    font-weight: 650;
  }
  [data-count] {
    font-variant-numeric: tabular-nums;
    font-weight: 650;
  }
  progress {
    display: block;
    width: 100%;
    height: 0.45rem;
    margin: 0.75rem 0;
    border: 0;
    border-radius: 1rem;
    overflow: hidden;
    appearance: none;
    background: var(--surface);
  }
  progress::-webkit-progress-bar {
    background: var(--surface);
    border-radius: 1rem;
  }
  progress::-webkit-progress-value {
    background: var(--accent-strong);
    border-radius: 1rem;
  }
  progress::-moz-progress-bar {
    background: var(--accent-strong);
    border-radius: 1rem;
  }
  .details {
    margin-top: 0.65rem;
    font-size: 0.65rem;
  }
  a {
    margin-left: auto;
    white-space: nowrap;
  }
  a:hover,
  button:hover {
    text-decoration: underline;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  button {
    cursor: pointer;
  }
  [hidden] {
    display: none;
  }
</style>

<script>
  class LeetCodeCard extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.querySelector("button")?.addEventListener("click", this.load);
      void this.load();
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.querySelector("button")?.removeEventListener("click", this.load);
    }

    private load = async () => {
      this.controller?.abort();
      const controller = new AbortController();
      this.controller = controller;
      const count = this.querySelector<HTMLElement>("[data-count]")!;
      const status = this.querySelector<HTMLElement>("[data-status]")!;
      const progress = this.querySelector("progress")!;
      const retry = this.querySelector("button")!;
      count.textContent = "加载中…";
      status.textContent = "正在获取进度";
      retry.hidden = true;
      progress.hidden = true;
      const timeout = window.setTimeout(() => controller.abort(), 10000);
      try {
        const response = await fetch(
          "https://raw.githubusercontent.com/Piao-2024/leetcode-metrics-api/main/data/progress.json",
          { signal: controller.signal, cache: "no-cache" }
        );
        if (!response.ok) throw new Error("Could not load progress");
        const data = await response.json();
        if (!data.updated_at || !data.username) {
          count.textContent = "— / 100";
          status.textContent = "尚未同步";
          return;
        }
        const { solved, total } = data.hot100 ?? {};
        const updatedAt = new Date(data.updated_at);
        if (
          data.schema_version !== 1 ||
          data.site !== "cn" ||
          data.username !== "piao-16m" ||
          !Number.isInteger(solved) ||
          total !== 100 ||
          solved < 0 ||
          solved > total ||
          Number.isNaN(updatedAt.getTime())
        )
          throw new Error("Invalid progress data");
        count.textContent = `${solved} / ${total}`;
        progress.max = total;
        progress.value = solved;
        progress.hidden = false;
        const time = document.createElement("time");
        time.dateTime = data.updated_at;
        time.textContent = new Intl.DateTimeFormat("zh-CN", {
          timeZone: "Asia/Shanghai",
          month: "2-digit",
          day: "2-digit",
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        }).format(updatedAt);
        time.title = `${updatedAt.toLocaleString("zh-CN", { timeZone: "Asia/Shanghai" })} 北京时间`;
        status.replaceChildren("更新于 ", time, "（北京时间）");
      } catch {
        if (!this.isConnected || this.controller !== controller) return;
        count.textContent = "— / 100";
        status.textContent = "暂时无法加载";
        retry.hidden = false;
      } finally {
        window.clearTimeout(timeout);
      }
    };
  }

  if (!customElements.get("leetcode-card")) {
    customElements.define("leetcode-card", LeetCodeCard);
  }
</script>
